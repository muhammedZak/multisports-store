NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/multisports_store

CLIENT_ORIGINS=http://localhost:5173

LOW_STOCK_THRESHOLD=5
APP_TIMEZONE=Asia/Kolkata

SESSION_SECRET=replace_with_a_long_random_secret
AUTH_CHALLENGE_SECRET=replace_with_a_different_long_random_secret

RESEND_API_KEY=
RESEND_FROM_EMAIL=

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development-only demo seed safety. Keep disabled during normal app usage.
# Before running a seed command, MONGODB_URI must point to this dedicated DB.
ALLOW_DEMO_SEED=false
DEMO_SEED_DATABASE=
DEMO_SEED_ANCHOR_DATE=
ALLOW_DEMO_CLOUDINARY_UPLOAD=false
DEMO_SEED_PASSWORD=
